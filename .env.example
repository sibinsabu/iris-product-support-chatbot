# ==============================================================================
# Azure OpenAI Credentials
# (Set these in Render Dashboard -> Environment -> Environment Variables)
# ==============================================================================
# Important: Use your Azure OpenAI endpoint (e.g. https://your-resource.openai.azure.com)
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_key_here

# Model Deployments
TEXT_MODEL_DEPLOYMENT=gpt-4o
VISION_MODEL_DEPLOYMENT=gpt-4o
IMAGE_MODEL_DEPLOYMENT=flux-1.1-pro

# ==============================================================================
# Azure Speech Services (Optional - for speech transcription)
# ==============================================================================
SPEECH_ENDPOINT=https://your-region.api.cognitive.microsoft.com
SPEECH_API_KEY=your_speech_key_here
SPEECH_REGION=eastus

# ==============================================================================
# Content Understanding / Foundry Services (Optional)
# ==============================================================================
CONTENT_ENDPOINT=https://your-foundry-resource.services.ai.azure.com
CONTENT_API_KEY=your_content_key_here
CONTENT_API_VERSION=2025-11-01

# Microsoft Foundry Agent / Project Endpoint (Optional)
FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
FOUNDRY_API_KEY=your_foundry_api_key_here
FOUNDRY_AGENT_ID=your_agent_id_here
